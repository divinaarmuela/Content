# Settings for `npm run e2e` (Playwright, e2e/**). Copy to .env.e2e (git-ignored)
# and fill in. The run refuses to start and lists what is missing until it is
# complete. Clerk keys and the database URL come from .env.local unless set here.

# ── where ────────────────────────────────────────────────────────────────
# the port for the dev server the run starts for itself
E2E_PORT=3107
# must be the ZZ E2E Test Client — the run refuses any other
E2E_CLIENT_ID=d59d3fb2-c775-4782-b966-d61700a5de93
# the ZZ client's portal share token (clients/<id>/share_token)
E2E_PORTAL_TOKEN=

# ── which database ───────────────────────────────────────────────────────
# The app has ONE database (project test-agent-88a4c). Two ways to run:
#
# (a) a SEPARATE database seeded with the ZZ client, its channels and the
#     three people below. Everything runs, including booking (J1b, J5):
# E2E_FIREBASE_DATABASE_URL=https://<a-separate-test-project>-default-rtdb.firebaseio.com
# E2E_ISOLATED_DB=1
#     and, for a booked post to reach Posted (J1b), a local Inngest dev server:
#     npx inngest-cli@latest dev -u http://localhost:3107/api/inngest
# E2E_INNGEST_URL=http://127.0.0.1:8288
#
# (b) the LIVE database, ZZ client only, with the owner's agreement. J1b and
#     J5 are skipped: a booking writes a publish job, and the live site's own
#     dispatcher would post it with the REAL publisher.
# E2E_LIVE_DB_OK=1

# ── who (Clerk DEV instance users; sign-in uses Clerk testing tokens) ────
# Each must exist in the Clerk dev instance AND have a team row on the ZZ client:
# role scheduler
E2E_SCHEDULER_EMAIL=
# the quality checker (role quality_checker, or the quality_reviewer flag); NOT a super admin
E2E_REVIEWER_EMAIL=
# role account_manager, on the ZZ client
E2E_MANAGER_EMAIL=

# ── the ZZ client's test channels (social_accounts ids; test accounts only) ──
E2E_CHANNEL_INSTAGRAM_ID=
E2E_CHANNEL_LINKEDIN_ID=

# optional: how to start the server (default: npx next dev --webpack --port $E2E_PORT;
# webpack because Turbopack refuses a symlinked node_modules, as in a git worktree)
# E2E_DEV_COMMAND=
