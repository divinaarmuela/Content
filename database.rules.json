{
  "rules": {
    "mdm": {
      ".read": true,
      "tables": {
        ".write": true,
        "$table": {
          ".indexOn": ["client_id", "status", "batch_id", "owner_id", "team_user_id", "created_at", "scheduled_for", "due_date", "item_id", "email", "token", "updated_at", "board_id"]
        }
      },
      "live": {
        ".write": true
      },
      "meta": {
        ".write": true
      },
      "uniq": {
        "$table": {
          "$field": {
            "$key": {
              ".write": "!data.exists() || data.val() === newData.val() || !newData.exists()"
            }
          }
        }
      }
    },
    "$other": { ".read": false, ".write": false }
  }
}
